{
  "name": "apache-autoindex-parse",
  "version": "5.0.2",
  "description": "parse apache's autoindex html files",
  "type": "module",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "packageManager": "pnpm@12.21.0",
  "license": "MIT",
  "homepage": "https://github.com/luxass/apache-autoindex-parse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/apache-autoindex-parse.git"
  },
  "bugs": {
    "url": "https://github.com/luxass/apache-autoindex-parse/issues"
  },
  "keywords": [
    "autoindex",
    "parse",
    "apache"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./test-utils": {
      "import": "./dist/test-utils.mjs",
      "require": "./dist/test-utils.cjs"
    },
    "./traverse": {
      "import": "./dist/traverse.mjs",
      "require": "./dist/traverse.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "testcontainers": "catalog:test",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test",
    "vitest-testdirs": "catalog:test"
  }
}
